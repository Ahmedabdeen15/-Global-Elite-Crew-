# ── Contact form (EmailJS) ────────────────────────────────────────────────
# Create a free account at https://www.emailjs.com/ and copy your ids.
# The legacy credentials from main.js only work client-side without secret
# scope, but keeping them configurable avoids hardcoding third-party ids.
# All three must be NEXT_PUBLIC_* because EmailJS runs in the browser.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# ── Analytics (optional) ──────────────────────────────────────────────────
# Legacy measurement id from old-code pages; omit to disable GA entirely.
# NEXT_PUBLIC_GA_ID=G-PQM1RXE71K
